+void
+get_xresources_colors(struct alert *a)
+{
+	FILE *f = fopen(xresources, "r");
+	if (!f) {
+		fprintf(stderr, "Could not open file: %s\n", xresources);
+		exit(EXIT_FAILURE);
+	}
+
+	char buffer[XR_BUFFER];
+
+	char colors[2][8];
+	int clr_i=0;
+
+	char *arr[2];
+
+	for (int i=0; i<4; i++) {
+		fgets(buffer, sizeof(buffer), f);
+
+		if (i <= 1) continue;
+
+		arr[0] = strtok(buffer, "#");
+		arr[1] = strtok(NULL, "#\n");
+
+		strncpy(colors[clr_i++], arr[1], 7);
+	}
+
+	strcpy(a->text_color, colors[0]);
+	strcpy(a->border_color, colors[0]);
+	strcpy(a->bg_color, colors[1]);
+
+	fclose(f);
+}
